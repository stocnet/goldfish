linters: linters_with_defaults(
  cyclocomp_linter = NULL,
  # Strict snake_case for all functions/arguments/objects. The `regexes`
  # allowlist exempts legacy S3 method names that encode class names / model
  # acronyms in the method: the goldfish S3 classes (`print.data.goldfish`,
  # `check_events.nodes.goldfish`, `coef.result.goldfish`, ...) and the
  # model-keyed effect-init dispatchers (`init_DyNAM_choice.ego`,
  # `init_REM_choice.alter`, `init_DyNAMi_rate.default`, `getLikelihoodMM`).
  # Remaining camelCase (the frozen estimation/optimizer/C++ contract names in
  # estimation_core.R / cpp_interface.R / model_preprocess.R) is reported as
  # known legacy, pending its own migration.
  object_name_linter(
    styles = "snake_case",
    regexes = c("goldfish", "DyNAM", "REM", "^[A-Z][A-Z0-9_]*$")
  ),
  line_length_linter(80),
  commented_code_linter = NULL,
  object_usage_linter = NULL,
  commas_linter = NULL, # 42 [, , ]
  object_length_linter = NULL,
  indentation_linter = NULL
    # indentation_linter(indent = 2L, hanging_indent_style = "tidy")
  )
exclusions: list(
  "inst/goldfish_logo.R", "R/RcppExports.R", "R/zzz.R",
  'tests/test_not_passed/helper_effects.R',
  'tests/test_not_passed/helper_effects_attributes.R',
  'tests/test_not_passed/helper_effects_bipartite.R',
  'tests/test_not_passed/helper_effects_directed.R',
  'tests/test_not_passed/helper_effects_twomode.R',
  'tests/test_not_passed/test_effects_ego.R',
  'tests/test_not_passed/test_effects_inertia_DyNAM_choice.R',
  'vignettes/dynami-example.R', 'vignettes/teaching1.R',
  'vignettes/teaching2.R'
  )
