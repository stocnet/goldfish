# Claude Code: share project tooling (settings.json hooks + agents); keep
# personal permission allow-lists and local worktrees out of git.
.claude/settings.local.json
.claude/worktrees/
# Personal memory: points at an Obsidian decision-record vault only I have.
CLAUDE.local.md

# OpenSpec: share config, the living folded spec, and active proposals so a
# collaborator has the same standards; keep the personal per-change session
# journal (progress.md), archived changes (delete-on-archive), and the
# parallel-session ownership claims local.
openspec/changes/archive/
openspec/changes/*/progress.md
openspec/changes/_claims/

# .plan is scratch; track only the cross-version benchmark ledger and the
# tooling that maintains it.
.plan/*
!.plan/goldfish_versions.csv
!.plan/profile_goldfish.R
!.plan/opsx-archive-track.sh
!.plan/opsx-spec-placement-check.sh
